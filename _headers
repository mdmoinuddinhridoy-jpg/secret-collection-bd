# Cloudflare Pages headers for Secret Collection BD
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Lists that change often: always check for the latest version
/products.json
  Cache-Control: no-cache
/banners.json
  Cache-Control: no-cache
/reviews.json
  Cache-Control: no-cache
/config.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Site styles: re-checked every visit but tiny thanks to the browser cache
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate
